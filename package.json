{
  "name": "iila-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "include": [
      "/",
      "/about",
      "/our-people",
      "/mission",
      "/publications",
      "/human-rights",
      "/roadmap",
      "/committees",
      "/partners",
      "/expert-network",
      "/media",
      "/contact"
    ],
    "headless": true,
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "inlineCss": true,
    "minifyHtml": { "collapseWhitespace": true, "removeComments": true }
  },
  "dependencies": {
    "framer-motion": "^11.0.6",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.12"
  }
}
