# Server-only configuration; do not add VITE_ prefixes.
# Collection is disabled by default.
# Owner/admin mailbox: info@iila-swiss.org. Use only an independent IILA-owned backend.
# Submitted cases have no automatic expiry; no retention-days setting.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
INTAKE_ENCRYPTION_KEY=
INTAKE_SESSION_KEY=
INTAKE_STAFF_IDS=
INTAKE_CLAMAV_HOST=
INTAKE_CLAMAV_PORT=3310
INTAKE_CLAMAV_CA=
INTAKE_CLAMAV_CLIENT_CERT=
INTAKE_CLAMAV_CLIENT_KEY=
INTAKE_SMTP_PASSWORD=
INTAKE_ORIGIN=https://iila-swiss.org
INTAKE_PRIVACY_VERSION=
INTAKE_SECURITY_VERIFIED=false
INTAKE_MAIL_VERIFIED=false
INTAKE_COLLECTION_ENABLED=false
